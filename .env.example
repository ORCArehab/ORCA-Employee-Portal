# Copy this file to .env.local and fill in real values there.
# .env.local (and all .env* files) are already gitignored — never commit
# real secrets.

# --- Google OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js session encryption secret ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- ORCA Workspace restriction ---
# The Google Workspace domain allowed to sign in, e.g. orcarehab.com.
# No accounts outside this domain can be authorized, regardless of
# whether Google authentication succeeds. Required — auth fails closed
# (nobody is authorized) if this is unset.
ALLOWED_GOOGLE_DOMAIN=

# --- Local-development roles (only without the ORCA API) ---
# With CAREERS_API_URL/KEY set, roles come from the ORCA API and are managed
# at /admin/people; these lists are ignored. Without the API, these
# comma-separated emails get ADMIN / HR on sign-in.
ADMIN_EMAILS=

# --- Canonical origin ---
# Required in production. Pins the exact origin Auth.js builds callback/
# redirect URLs from and validates cookies against — set to the real
# production URL, not inferred from request headers. Leave unset in local
# dev (falls back to trusting the request Host header via trustHost).
# Production (set in Vercel, Production environment only):
# AUTH_URL=https://portal.orcarehab.com

# --- Employee directory (/directory) ---
# Real names/emails, so this is never committed — set the real value only
# in .env.local and in Vercel's project env vars. See src/config/staff.ts
# for the exact shape (StaffGroup[]) and a fallback if unset.
STAFF_DIRECTORY_JSON=

HR_EMAILS=

# --- ORCA API (the Careers API service on Cloud Run) ---
# Job applications, and the people and roles every ORCA app shares.
# Server-only; never NEXT_PUBLIC_. The key must equal PORTAL_API_KEY in the
# API, and this app's GOOGLE_CLIENT_ID must be listed in its GOOGLE_CLIENT_IDS.
# Local development: CAREERS_API_URL=http://localhost:8080
CAREERS_API_URL=
CAREERS_API_KEY=
