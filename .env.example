# Copy this file to .env.local and fill in real values there.
# .env.local (and all .env* files) are already gitignored — never commit
# real secrets.

# --- Google OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js session encryption secret ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- ORCA Workspace restriction ---
# The Google Workspace domain allowed to sign in, e.g. orcarehab.com.
# No accounts outside this domain can be authorized, regardless of
# whether Google authentication succeeds. Required — auth fails closed
# (nobody is authorized) if this is unset.
ALLOWED_GOOGLE_DOMAIN=

# --- Temporary admin bootstrap (interim, until there's a real user store) ---
# Comma-separated list of email addresses to grant the ADMIN role on
# sign-in. Everyone else in ALLOWED_GOOGLE_DOMAIN gets EMPLOYEE. See
# src/lib/authorization.ts.
ADMIN_EMAILS=

# --- Canonical origin ---
# Required in production. Pins the exact origin Auth.js builds callback/
# redirect URLs from and validates cookies against — set to the real
# production URL, not inferred from request headers. Leave unset in local
# dev (falls back to trusting the request Host header via trustHost).
# Production (set in Vercel, Production environment only):
# AUTH_URL=https://portal.orcarehab.com
